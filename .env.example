# Chave pessoal do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelos no formato "provedor:modelo". O auditor usa outro modelo de propósito.
AGENT_MODEL=google_genai:gemini-3.5-flash-lite
JUDGE_MODEL=google_genai:gemini-3.1-flash-lite
# GUARDRAIL_MODEL=  (se vazio, usa o mesmo do agente)

# Requisições por minuto (ajuste à cota do seu plano)
REQUESTS_PER_MINUTE=10
